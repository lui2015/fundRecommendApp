# 服务端口（与求一票 3210 / stockforecast 3000 / investment-quotes 3030 不冲突）
PORT=3220

# 腾讯混元大模型
HUNYUAN_API_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
HUNYUAN_API_KEY=sk-xxxxxxxxxxxxxxxx
HUNYUAN_MODEL=hy3
HUNYUAN_TIMEOUT_MS=45000

# 限流
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30

# 荐基 Skill 路径（git clone https://github.com/lui2015/FUND-RECOMMEND-SKILL.git 到此目录）
SKILL_DIR=./vendor/FUND-RECOMMEND-SKILL
PYTHON_BIN=python3

# 数据目录（保存的推荐记录与 HTML 报告，部署时切勿整体覆盖）
DATA_DIR=./data
